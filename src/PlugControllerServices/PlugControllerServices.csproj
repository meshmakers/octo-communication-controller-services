<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <AssemblyName>Meshmakers.Octo.Backend.PlugControllerServices</AssemblyName>
        <Description>Manages Plugs and Sockets for data ingress and egress of an Octo Mesh instance</Description>
        <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
        <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
        <IsPackable>false</IsPackable>
        <OutputType>Exe</OutputType>
        <RootNamespace>Meshmakers.Octo.Backend.PlugControllerServices</RootNamespace>
        <StartupObject />
        <UserSecretsId>04bcde24-0d21-4346-8459-3bca58abec32</UserSecretsId>
        <Version>1.0.0</Version>
        <TargetFramework>net7.0</TargetFramework>
        <ImplicitUsings>true</ImplicitUsings>
    </PropertyGroup>

    <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
        <OutputPath>../../bin/Debug/PlugControllerServices/</OutputPath>
        <DocumentationFile>../../bin/Debug/PlugControllerServices/Meshmakers.Octo.Backend.PlugControllerServices.xml</DocumentationFile>
        <NoWarn>1701;1702;CS8002</NoWarn>
    </PropertyGroup>

    <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
        <OutputPath>../../bin/Release/PlugControllerServices/</OutputPath>
        <DocumentationFile>../../bin/Release/PlugControllerServices/Meshmakers.Octo.Backend.PlugControllerServices.xml</DocumentationFile>
        <NoWarn>1701;1702;CS8002</NoWarn>
    </PropertyGroup>
    
    <ItemGroup>
        <PackageReference Include="MassTransit.RabbitMQ" Version="8.0.16" />
        <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="7.0.8" />
        <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="7.0.8" />
        <PackageReference Include="NLog.Web.AspNetCore" Version="5.3.0" />
    </ItemGroup>

    <ItemGroup>
      <Content Include="..\.dockerignore">
        <Link>.dockerignore</Link>
      </Content>
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\PlugControllerServices.Resources\PlugControllerServices.Resources.csproj" />
      <ProjectReference Include="..\octo-common-services\src\Swagger\Swagger.csproj" />
      <ProjectReference Include="..\octo-core\src\Common\Communication.Contracts\Communication.Contracts.csproj" />
      <ProjectReference Include="..\octo-core\src\Common\Communication.Plugs.Contracts\Communication.Plugs.Contracts.csproj" />
      <ProjectReference Include="..\octo-core\src\SystematizedData\Persistence\Persistence.csproj" />
    </ItemGroup>

    <ItemGroup>
      <Content Remove="nlog.config" />
      <None Include="nlog.config">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </None>
    </ItemGroup>

    <ItemGroup>
      <Folder Include="Caches\" />
    </ItemGroup>

</Project>
