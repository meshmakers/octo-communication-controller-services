<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <Description>OctoMesh System communication construction kit model</Description>
        <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
        <PackageId>Meshmakers.Octo.ConstructionKit.Models.System.Communication</PackageId>
        <AssemblyName>Meshmakers.Octo.ConstructionKit.Models.System.Communication</AssemblyName>
        <RootNamespace>Meshmakers.Octo.ConstructionKit.Models.System.Communication</RootNamespace>
        <Configurations>Debug;Release;DebugL</Configurations>
        <Platforms>AnyCPU</Platforms>
        <!-- Only publish/generate-docs during the primary build, not during the nested MSBuild call that
             GeneratePackageOnBuild's Pack target makes — otherwise the CK compile+publish runs twice and the
             second run hits remote catalogs again, which has hung CI builds for the full HttpClient timeout. -->
        <OctoPublishCkModel Condition="'$(TargetFramework)' == 'net10.0' AND '$(_IsPacking)' != 'true'">true</OctoPublishCkModel>
        <OctoGenerateCkDocumentation Condition="'$(TargetFramework)' == 'net10.0' AND '$(_IsPacking)' != 'true'">true</OctoGenerateCkDocumentation>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Meshmakers.Octo.Runtime.Contracts" Version="$(OctoCoreLibVersion)" />
        <PackageReference Include="Meshmakers.Octo.ConstructionKit.SourceGeneration" OutputItemType="Analyzer" ReferenceOutputAssembly="false" Version="$(OctoCoreLibVersion)" />
        <PackageReference Include="Meshmakers.Octo.ConstructionKit.MsBuildTasks" Version="$(OctoCoreLibVersion)" PrivateAssets="all" />
        <PackageReference Include="Meshmakers.Octo.ConstructionKit.Models.System.Bot" Version="$(OctoCkModelVersion)" />
    </ItemGroup>

    <ItemGroup>
        <None Include="..\..\assets\meshmakers64.png">
            <Pack>True</Pack>
            <PackagePath />
            <Link>meshmakers64.png</Link>
        </None>
        <None Include="..\..\LICENSE">
            <Pack>True</Pack>
            <PackagePath />
            <Link>LICENSE</Link>
        </None>
        <None Remove="ConstructionKit\types\sendConfiguration.yaml" />
    </ItemGroup>

    <ItemGroup>
        <ConstructionKitFolder Visible="false" Include="$(MSBuildProjectDirectory)\ConstructionKit"/>
    </ItemGroup>

    <ItemGroup>
        <!--
            Blueprints shipped with this CK-model package. The BlueprintEmbed MSBuild task picks
            up every subdirectory and embeds the files as manifest resources; the
            BlueprintSourceGenerator then emits IBlueprintEmbeddedSource + AddBlueprint<Name>V<Major>
            extensions so consuming services only need to call the generated DI extensions and the
            engine's EmbeddedResourceBlueprintCatalog handles the rest.
        -->
        <BlueprintFolder Visible="false" Include="$(MSBuildProjectDirectory)\Blueprints"/>
    </ItemGroup>
</Project>
